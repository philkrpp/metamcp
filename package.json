{
  "name": "metamcp",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "dotenv -e .env.local turbo run dev",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "dev:docker:down": "docker compose -f docker-compose.dev.yml down",
    "dev:docker:clean": "docker compose -f docker-compose.dev.yml down -v --remove-orphans",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prettier": "3.5.3",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "@eslint/plugin-kit@<0.3.4": "^0.3.4",
      "@hono/node-server@1": "~1.19.15",
      "@humanfs/node@<0.16.8": "^0.16.8",
      "@modelcontextprotocol/sdk@<1.31.0": "1.31.0",
      "ajv@6": "^6.14.0",
      "body-parser@<2.3.0": "^2.3.0",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "defu@<6.1.5": "^6.1.5",
      "esbuild@<0.25.0": "^0.25.0",
      "fast-uri@3": "~3.1.8",
      "flatted@<3.4.2": "^3.4.2",
      "glob@10": "^10.5.0",
      "hono@4": "~4.13.7",
      "ip-address@10": "~10.7.1",
      "js-cookie@<3.0.7": "^3.0.7",
      "js-yaml@4": "^4.3.2",
      "lodash@<4.18.0": "^4.18.0",
      "minimatch@3": "^3.1.4",
      "minimatch@9": "^9.0.7",
      "path-to-regexp@8": "^8.4.0",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "postcss@<8.5.23": "^8.5.23",
      "prismjs@<1.30.0": "^1.30.0",
      "proxy-addr@2": "~2.0.8",
      "qs@6": "^6.16.0",
      "rollup@4": "^4.59.0",
      "sharp@0": "^0.35.5",
      "source-map-js@1": "^1.2.2",
      "tar@7": "^7.5.21",
      "vite@7": "^7.3.5"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "sharp"
    ]
  }
}
